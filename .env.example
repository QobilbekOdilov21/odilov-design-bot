# From https://t.me/BotFather - do NOT commit your real token.
BOT_TOKEN=123456789:REPLACE_WITH_BOTFATHER_TOKEN
# Get your numeric ID using https://t.me/userinfobot (for example)
ADMIN_IDS=123456789
# The Telegram channel where your portfolio is published:
PORTFOLIO_URL=https://t.me/your_odilov_channel
# Your Telegram username WITHOUT @ (replace with your own):
MANAGER_USERNAME=yourusername
# This must be a persistent volume on any cloud hosting!
DATABASE_PATH=./data/odilov.db
TIMEZONE=Asia/Tashkent
